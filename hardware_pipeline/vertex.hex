// vertex_memory.hex - 2 triangles = 6 vertices, one 144-bit word per line
// word = { X[31:0], Y[31:0], Z[31:0], W[31:0], RGB565[15:0] }  (Q24.8, 1.0 = 00000100)
// comments show object-space values; the matrix moves them by (+0.125, -0.125)
// T0 green, NEAR (z = -0.25), drawn first
FFFFFFE000000020FFFFFFC00000010007E0  // v0  x=-0.1250 y=+0.1250 z=-0.25 w=1.0
0000006000000020FFFFFFC00000010007E0  // v1  x=+0.3750 y=+0.1250 z=-0.25 w=1.0
00000020FFFFFFA0FFFFFFC00000010007E0  // v2  x=+0.1250 y=-0.3750 z=-0.25 w=1.0
// T1 red,   FAR  (z = +0.50), drawn second
FFFFFFC0000000400000008000000100F800  // v0  x=-0.2500 y=+0.2500 z=+0.50 w=1.0
00000040000000400000008000000100F800  // v1  x=+0.2500 y=+0.2500 z=+0.50 w=1.0
00000000FFFFFFC00000008000000100F800  // v2  x=+0.0000 y=-0.2500 z=+0.50 w=1.0
