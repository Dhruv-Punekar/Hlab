// matrix_memory.hex - 4x4 transform matrix, Q24.8, ROW-MAJOR
// line k = M[k/4][k%4]: line 0 = M00, line 3 = M03 (x-translation), line 15 = M33
// here: identity + translate x by +0.125 (M03) and y by -0.125 (M13)
00000100  // M00 = +1.000
00000000  // M01 = +0.000
00000000  // M02 = +0.000
00000020  // M03 = +0.125
00000000  // M10 = +0.000
00000100  // M11 = +1.000
00000000  // M12 = +0.000
FFFFFFE0  // M13 = -0.125
00000000  // M20 = +0.000
00000000  // M21 = +0.000
00000100  // M22 = +1.000
00000000  // M23 = +0.000
00000000  // M30 = +0.000
00000000  // M31 = +0.000
00000000  // M32 = +0.000
00000100  // M33 = +1.000
